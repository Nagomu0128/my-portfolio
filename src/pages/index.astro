---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

const recentProducts = products.slice(0, 3);
---

<BaseLayout title="Kazuya Yoshida | Portfolio" activePage="overview">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-5 order-lg-2 mb-4 mb-lg-0">
          <div class="profile-image-wrapper text-center">
            <img
              src="/images/profile.png"
              alt="Kazuya Yoshida"
              class="profile-image"
            />
          </div>
        </div>
        <div class="col-lg-7 order-lg-1">
          <h1 class="hero-title">吉田 和哉</h1>
          <p class="hero-subtitle">
            大阪大学工学部 電子情報工学科 B2。
            フルスタック開発を中心に、Web・クラウド・インフラまで幅広く挑戦しています。
          </p>
          <div class="hero-cta">
            <a href="/about" class="btn btn-primary-custom">About</a>
            <a href="/products" class="btn btn-outline-custom">Products</a>
          </div>

          <div class="social-links">
            <a href="https://github.com/Nagomu0128" target="_blank" rel="noopener" class="social-link" title="GitHub">
              <i class="bi bi-github"></i>
            </a>
            <a href="https://github.com/gdsc-osaka" target="_blank" rel="noopener" class="social-link" title="GitHub (GDSC)">
              <i class="bi bi-github"></i>
            </a>
            <a href="https://twitter.com/devnago0" target="_blank" rel="noopener" class="social-link" title="X">
              <i class="bi bi-twitter-x"></i>
            </a>
            <a href="https://linkedin.com/" target="_blank" rel="noopener" class="social-link" title="LinkedIn">
              <i class="bi bi-linkedin"></i>
            </a>
            <a href="mailto:kyoshidk@gmail.com" class="social-link" title="Email">
              <i class="bi bi-envelope"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <hr class="section-divider" />
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Overview</h2>
        <p class="section-subtitle">開発が好きなエンジニア。テック系の記事を読むのが日課です。</p>
      </div>

      <div class="row g-4">
        <div class="col-md-6 col-lg-4">
          <div class="card-custom h-100">
            <div class="card-body-custom">
              <h4 class="card-title-custom mb-2">Web Development</h4>
              <p class="card-text-custom">
                Next.js, React, TypeScriptを中心としたモダンなフロントエンド開発。
                パフォーマンスとユーザー体験を重視した設計を心がけています。
              </p>
              <div class="tech-tags">
                <span class="tech-tag">Next.js</span>
                <span class="tech-tag">React</span>
                <span class="tech-tag">TypeScript</span>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card-custom h-100">
            <div class="card-body-custom">
              <h4 class="card-title-custom mb-2">Cloud &amp; Infrastructure</h4>
              <p class="card-text-custom">
                GCP, Azureなどのクラウドサービスに興味があり、現在学習中。
                Docker, Azure, Terraformを使ったインフラ構築を勉強しています。
              </p>
              <div class="tech-tags">
                <span class="tech-tag">GCP</span>
                <span class="tech-tag">Azure</span>
                <span class="tech-tag">Docker</span>
                <span class="tech-tag">Kubernetes</span>
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card-custom h-100">
            <div class="card-body-custom">
              <h4 class="card-title-custom mb-2">Backend &amp; Database</h4>
              <p class="card-text-custom">
                Go, Python を使用したAPI開発。
                PostgreSQL, Firebaseなどのデータベース設計・運用。
              </p>
              <div class="tech-tags">
                <span class="tech-tag">Go</span>
                <span class="tech-tag">Python</span>
                <span class="tech-tag">PostgreSQL</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Products -->
  {recentProducts.length > 0 && (
    <section class="section" style="background: var(--color-bg-alt);">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title">Recent Products</h2>
        </div>

        <div class="row g-4">
          {recentProducts.map((product, index) => (
            <ProductCard {...product} index={index} />
          ))}
        </div>

        <div class="text-center mt-4">
          <a href="/products" class="btn btn-outline-custom">
            View All
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Contact Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Contact</h2>
      </div>

      <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
          <div class="contact-card">
            <div class="contact-icon">
              <i class="bi bi-envelope"></i>
            </div>
            <h4 class="contact-title">Email</h4>
            <p class="contact-text">kyoshidk@gmail.com</p>
            <a href="mailto:kyoshidk@gmail.com" class="btn btn-outline-custom btn-sm mt-3">
              Send Email
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

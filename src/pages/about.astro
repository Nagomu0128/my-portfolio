---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Kazuya Yoshida" description="About Kazuya Yoshida - Software Engineer & Developer" activePage="about">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1 class="section-title">About</h1>
    </div>
  </section>

  <!-- Profile Section -->
  <section class="section pt-0">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-4">
          <div class="profile-image-wrapper">
            <img
              src="/images/profile.png"
              alt="Kazuya Yoshida"
              class="profile-image about-profile-image"
            />
          </div>
        </div>
        <div class="col-lg-8">
          <h2 class="mb-3">吉田 和哉</h2>
          <div class="mb-4">
            <p class="mb-3">
              大阪大学工学部 電子情報工学科 B2の学生です。
              電子回路とコンピュータサイエンスについて日々勉強しています。
            </p>
            <p class="mb-3">
              開発経験はまだ浅いですが、開発が大好きで、テック系の記事を読むのが日課です。
              新しい技術に触れることが好きで、フロントエンドからインフラまで幅広く挑戦しています。
            </p>
            <p>
              趣味は一人旅で、B2の春に九州一周一人旅をしました。
              どこかおすすめの旅先を知っていたらぜひ教えてください！
            </p>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-sm-6">
              <small style="color: var(--color-text-muted);">Location</small>
              <p class="mb-0" style="font-size: 0.95rem;">Osaka, Japan</p>
            </div>
            <div class="col-sm-6">
              <small style="color: var(--color-text-muted);">University</small>
              <p class="mb-0" style="font-size: 0.95rem;">Osaka University</p>
            </div>
            <div class="col-sm-6">
              <small style="color: var(--color-text-muted);">Birthday</small>
              <p class="mb-0" style="font-size: 0.95rem;">2006/01/28</p>
            </div>
            <div class="col-sm-6">
              <small style="color: var(--color-text-muted);">Email</small>
              <p class="mb-0" style="font-size: 0.95rem;">kyoshidk@gmail.com</p>
            </div>
          </div>

          <a href="mailto:kyoshidk@gmail.com" class="btn btn-primary-custom">
            Contact Me
          </a>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider container" />

  <!-- Timeline Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Experience</h2>
      </div>

      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="timeline">
            <div class="timeline-item">
              <p class="timeline-date">2024年4月~</p>
              <h4 class="timeline-title">大阪大学 工学部</h4>
              <p class="timeline-description">
                大阪大学工学部電子情報工学科に入学。
                電子回路とCSについて学び始める。
              </p>
            </div>

            <div class="timeline-item">
              <p class="timeline-date">2025年5月~</p>
              <h4 class="timeline-title">Google Developer Groups on Campus Osaka</h4>
              <p class="timeline-description">
                GDG on Campus Osakaに参加し、コミュニティでの活動を開始。<br />
                様々なイベントやハンズオンに参加しながら自らも講義を行う。
              </p>
            </div>

            <div class="timeline-item">
              <p class="timeline-date">2025年10月~</p>
              <h4 class="timeline-title">Kiei 長期インターンシップ</h4>
              <p class="timeline-description">
                Kieiに参加し、RAGを用いたアプリケーション開発に携わる。
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider container" />

  <!-- Skills Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Skills</h2>
      </div>

      <div class="row justify-content-center">
        <div class="col-lg-10">
          <div class="mb-5">
            <h5 class="skill-category-title text-center mb-4">Languages &amp; Frameworks</h5>
            <div class="d-flex flex-wrap justify-content-center gap-3">
              <div class="skill-item">
                <i class="devicon-typescript-plain colored"></i>
                <span>TypeScript</span>
              </div>
              <div class="skill-item">
                <i class="devicon-react-original colored"></i>
                <span>React</span>
              </div>
              <div class="skill-item">
                <i class="devicon-nextjs-plain"></i>
                <span>Next.js</span>
              </div>
              <div class="skill-item">
                <i class="devicon-remix-original"></i>
                <span>Remix</span>
              </div>
              <div class="skill-item">
                <i class="devicon-go-plain colored"></i>
                <span>Go</span>
              </div>
              <div class="skill-item">
                <i class="devicon-python-plain colored"></i>
                <span>Python</span>
              </div>
              <div class="skill-item">
                <i class="devicon-postgresql-plain colored"></i>
                <span>PostgreSQL</span>
              </div>
            </div>
          </div>

          <div>
            <h5 class="skill-category-title text-center mb-4">Infrastructure</h5>
            <div class="d-flex flex-wrap justify-content-center gap-3">
              <div class="skill-item">
                <i class="devicon-docker-plain colored"></i>
                <span>Docker</span>
              </div>
              <div class="skill-item">
                <i class="devicon-kubernetes-plain colored"></i>
                <span>Kubernetes</span>
              </div>
              <div class="skill-item">
                <i class="devicon-terraform-plain colored"></i>
                <span>Terraform</span>
              </div>
              <div class="skill-item">
                <i class="devicon-googlecloud-plain colored"></i>
                <span>GCP</span>
              </div>
              <div class="skill-item">
                <i class="devicon-azure-plain colored"></i>
                <span>Azure</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="section-divider container" />

  <!-- Interests Section -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Interests</h2>
      </div>

      <div class="row g-4 justify-content-center">
        <div class="col-md-6 col-lg-4">
          <div class="card-custom text-center">
            <div class="card-body-custom py-4">
              <h4 class="card-title-custom">一人旅</h4>
              <p class="card-text-custom">
                一人旅が好き。B2の春に九州一周の旅をしました。
                新しい場所を探索するのが楽しい。
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card-custom text-center">
            <div class="card-body-custom py-4">
              <h4 class="card-title-custom">日本酒</h4>
              <p class="card-text-custom">
                お酒が大好き、特に日本酒。
                各地の地酒を味わうのが趣味です。
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card-custom text-center">
            <div class="card-body-custom py-4">
              <h4 class="card-title-custom">テック記事</h4>
              <p class="card-text-custom">
                テック系の記事を読むのが日課。
                最新技術のトレンドを常にキャッチアップ。
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

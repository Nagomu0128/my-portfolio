---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getBlogs, getCategories } from '../data/blogs';

const blogs = await getBlogs();
const categories = getCategories(blogs);
---

<BaseLayout title="Blog | Kazuya Yoshida" description="Blog by Kazuya Yoshida" activePage="blog">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1 class="section-title">Blog</h1>
      <p class="section-subtitle">
        技術記事や日々の学びを発信しています
      </p>
    </div>
  </section>

  <!-- Blog Section -->
  <section class="section pt-0">
    <div class="container">
      <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8 mb-5 mb-lg-0">
          <div class="d-flex flex-column gap-4">
            {blogs.length > 0 ? (
              blogs.map((blog, index) => (
                <BlogCard {...blog} index={index} />
              ))
            ) : (
              <div class="text-center py-5">
                <p style="color: var(--color-text-muted);">
                  まだブログ記事が登録されていません。
                </p>
              </div>
            )}
          </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
          <div class="sticky-top" style="top: 80px;">
            <!-- About Widget -->
            <div class="card-custom mb-4">
              <div class="card-body-custom">
                <h5 class="mb-3">About</h5>
                <p class="card-text-custom mb-3">
                  大阪大学 工学部 電子情報工学科 B2。
                  開発が好きなエンジニア。
                </p>
                <a href="/about" class="btn btn-outline-custom btn-sm">
                  Read More
                </a>
              </div>
            </div>

            <!-- Categories Widget -->
            <div class="card-custom mb-4">
              <div class="card-body-custom">
                <h5 class="mb-3">Categories</h5>
                <div class="d-flex flex-wrap gap-2">
                  {categories.length > 0 ? (
                    categories.map(category => (
                      <span class="tech-tag">{category}</span>
                    ))
                  ) : (
                    <span style="color: var(--color-text-muted);">No categories yet</span>
                  )}
                </div>
              </div>
            </div>

            <!-- External Links Widget -->
            <div class="card-custom">
              <div class="card-body-custom">
                <h5 class="mb-3">Links</h5>
                <ul class="list-unstyled mb-0">
                  <li class="mb-2">
                    <a href="https://zenn.dev/nagomu" target="_blank" rel="noopener" style="color: var(--color-text-sub); text-decoration: underline; text-underline-offset: 3px;">
                      Zenn
                    </a>
                  </li>
                  <li class="mb-2">
                    <a href="https://qiita.com/" target="_blank" rel="noopener" style="color: var(--color-text-sub); text-decoration: underline; text-underline-offset: 3px;">
                      Qiita
                    </a>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

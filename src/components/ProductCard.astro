---
interface Props {
  title: string;
  description: string;
  image: string;
  technologies: string[];
  category?: string;
  demoUrl?: string;
  githubUrl?: string;
  date?: string;
  index?: number;
}

const {
  title,
  description,
  image,
  technologies,
  category = 'Project',
  demoUrl,
  githubUrl,
  date,
  index = 0
} = Astro.props;
---

<div
  class="col-md-6 col-lg-4 product-item"
  data-category={category.toLowerCase()}
>
  <div class="card-custom h-100">
    <div class="card-image-wrapper">
      <img
        src={image}
        alt={title}
        class="card-image"
        loading="lazy"
      />
      <div class="card-overlay">
        <div class="d-flex gap-2">
          {demoUrl && (
            <a href={demoUrl} target="_blank" rel="noopener" class="btn btn-primary-custom btn-sm">
              Demo
            </a>
          )}
          {githubUrl && (
            <a href={githubUrl} target="_blank" rel="noopener" class="btn btn-outline-custom btn-sm" style="color: #fff; border-color: rgba(255,255,255,0.5);">
              GitHub
            </a>
          )}
        </div>
      </div>
    </div>
    <div class="card-body-custom">
      <p class="card-tag">{category}</p>
      <h4 class="card-title-custom">{title}</h4>
      <p class="card-text-custom">{description}</p>
      <div class="tech-tags">
        {technologies.map((tech) => (
          <span class="tech-tag">{tech}</span>
        ))}
      </div>
      {date && (
        <div class="card-meta">
          <span>{date}</span>
        </div>
      )}
    </div>
  </div>
</div>

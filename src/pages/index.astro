---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';

const recentProducts = products.slice(0, 3);
---

<BaseLayout title="Kazuya Yoshida" activePage="overview">
  <section style="padding-top: 5rem;">
    <div class="container">
      <!-- Intro -->
      <div class="row align-items-center mb-5" style="padding: 2rem 0;">
        <div class="col-lg-8">
          <h1 style="font-size: 1.8rem; font-weight: 700; margin-bottom: 0.75rem;">吉田 和哉</h1>
          <p style="color: var(--color-text-sub); line-height: 1.8; margin-bottom: 1.5rem;">
            大阪大学工学部 電子情報工学科 B3。<br>
            フルスタック開発を中心に、Webアプリの開発をすることが多いです。
            開発が好きで、テック系の記事を読むのが日課です。あたらしい技術に触れることも好きなので、日々キャッチアップしながら様々のものを試しています。
          </p>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <a href="/about" class="btn btn-primary-custom">About</a>
            <a href="/products" class="btn btn-outline-custom">Products</a>
          </div>
          <div class="social-links" style="margin-top: 1rem;">
            <a href="https://github.com/Nagomu0128" target="_blank" rel="noopener" class="social-link" title="GitHub">
              <i class="bi bi-github"></i>
            </a>
            <a href="https://github.com/gdsc-osaka" target="_blank" rel="noopener" class="social-link" title="GitHub (GDSC)">
              <i class="bi bi-github"></i>
            </a>
            <a href="https://twitter.com/devnago0" target="_blank" rel="noopener" class="social-link" title="X">
              <i class="bi bi-twitter-x"></i>
            </a>
            <a href="https://linkedin.com/" target="_blank" rel="noopener" class="social-link" title="LinkedIn">
              <i class="bi bi-linkedin"></i>
            </a>
            <a href="mailto:kyoshidk@gmail.com" class="social-link" title="Email">
              <i class="bi bi-envelope"></i>
            </a>
          </div>
        </div>
        <div class="col-lg-4 text-center mt-4 mt-lg-0">
          <img
            src="/images/profile.png"
            alt="Kazuya Yoshida"
            class="profile-image"
          />
        </div>
      </div>

      <hr class="section-divider" />

      <!-- What I Do -->
      <div style="padding: 3rem 0;">
        <h2 style="font-size: 1.3rem; margin-bottom: 2rem;">What I Do</h2>
        <div class="row g-4">
          <div class="col-md-4">
            <h4 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.4rem;">Web Development</h4>
            <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.7;">
              Next.js, React, TypeScriptを中心としたフロントエンド開発。
            </p>
            <div class="tech-tags">
              <span class="tech-tag">Next.js</span>
              <span class="tech-tag">React</span>
              <span class="tech-tag">TypeScript</span>
              <span class="tech-tag">Remix</span>
            </div>
          </div>
          <div class="col-md-4">
            <h4 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.4rem;">Cloud &amp; Infra</h4>
            <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.7;">
              主にGCPを使用して開発することが多いです。Docker, Terraformも使用した開発経験。
            </p>
            <div class="tech-tags">
              <span class="tech-tag">GCP</span>
              <span class="tech-tag">Azure</span>
              <span class="tech-tag">Docker</span>
            </div>
          </div>
          <div class="col-md-4">
            <h4 style="font-size: 0.95rem; font-weight: 600; margin-bottom: 0.4rem;">Backend</h4>
            <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.7;">
              Go, Pythonでのバックエンド開発。PostgreSQL, Firebaseなどのデータベース設計。
            </p>
            <div class="tech-tags">
              <span class="tech-tag">Go</span>
              <span class="tech-tag">Python</span>
              <span class="tech-tag">PostgreSQL</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Products -->
      {recentProducts.length > 0 && (
        <>
          <hr class="section-divider" />
          <div style="padding: 3rem 0;">
            <h2 style="font-size: 1.3rem; margin-bottom: 2rem;">Recent Products</h2>
            <div class="row g-4">
              {recentProducts.map((product, index) => (
                <ProductCard {...product} index={index} />
              ))}
            </div>
            <div class="mt-4">
              <a href="/products" style="font-size: 0.9rem; text-decoration: underline; text-underline-offset: 3px;">
                View all &rarr;
              </a>
            </div>
          </div>
        </>
      )}

      <hr class="section-divider" />

      <!-- Contact -->
      <div style="padding: 3rem 0;">
        <h2 style="font-size: 1.3rem; margin-bottom: 1rem;">Contact</h2>
        <p style="color: var(--color-text-sub); font-size: 0.9rem;">
          <a href="mailto:kyoshidk@gmail.com" style="text-decoration: underline; text-underline-offset: 3px;">kyoshidk@gmail.com</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
